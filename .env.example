# Copy to .env and fill in. Everything has a default; the factory runs with no keys at all
# (Ollama + free Edge voices), keys only make it better.

# --- Script writer: auto (Claude if ANTHROPIC_API_KEY is set, else Ollama), ollama, or anthropic
LLM_PROVIDER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Voices: eleven (per character voices from data/cast.json) or edge (free Microsoft voices)
TTS_ENGINE=eleven
ELEVEN_API_KEY=
ELEVEN_MODEL=eleven_multilingual_v2

# --- vidIQ (optional): title scoring and searched tags. Same key as shorts_factory_v8
VIDIQ_API_KEY=
VIDIQ_MAX_CREDITS=20

# --- Video
FPS=30
# royalty free loop (YouTube Audio Library), mixed quietly under the voices. Empty = none
MUSIC_FILE=
MUSIC_VOLUME=0.10

# --- YouTube (client_secret.json + `python main.py auth`)
YT_PRIVACY=private
YT_CATEGORY=23
VIDEO_LANGUAGE=hi

# --- Autopilot
TZ_NAME=Asia/Kolkata
# exact times (19:30) or windows (19:00-19:30, a random minute inside each day)
SLOTS=07:00-07:30,12:00-12:30,19:00-19:30
# hold = every video waits for `python main.py approve <job>`; auto = uploads when the checks pass
REVIEW_MODE=auto

# --- API for n8n (made automatically on first `python main.py api`)
API_PORT=8770
FACTORY_API_TOKEN=

# --- Community: daily post kit + comment replies
COMMUNITY_POST_TIME=21:00
# auto = reply to safe comment kinds, hold = drafts only, off
COMMUNITY_REPLIES=auto
COMMUNITY_MAX_PER_DAY=40

# --- Telegram alerts + commands (python main.py telegram setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instagram Reels via vidIQ (link Instagram at app.vidiq.com first, then IG_MODE=vidiq)
IG_MODE=off
IG_ACCOUNT=
IG_HANDLE=@yourchannel
IG_MAX_PER_DAY=4
